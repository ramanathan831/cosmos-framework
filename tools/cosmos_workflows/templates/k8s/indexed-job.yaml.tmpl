#
# Cosmos MULTI-NODE Kubernetes template — the single-pod template's superset: a
# headless Service (created FIRST so DNS resolves when pods come up) + an Indexed
# Job + a rank/master rendezvous block. cosmos-run-on-kubernetes renders it by
# substituting @@<NAME>@@ (command uses single quotes only).
#
# REQUIRES k8s >= 1.28 (PodIndexLabel gives each pod the stable hostname
# <job>-<index>, so MASTER_ADDR=<job>-0.<svc> resolves). Verify with
# `kubectl version` before submit — on older clusters the rendezvous DNS silently
# fails and rank-0 hangs for the whole distributed timeout.
#
# NNODES is the node count; torchrun sets WORLD_SIZE for its worker processes.
# Credentials use envFrom.secretRef, never inline values.
apiVersion: v1
kind: Service
metadata:
  name: "@@JOB_NAME@@"
  labels:
    cosmos-job: "@@JOB_NAME@@"
spec:
  clusterIP: None            # headless — DNS returns the per-pod IPs for rendezvous
  # Rank-0's DNS name must resolve BEFORE any pod is Ready: every other rank
  # blocks on MASTER_ADDR to rendezvous, and pods only become Ready once the
  # workload is up. Without this the lookup NXDOMAINs and multi-node deadlocks.
  publishNotReadyAddresses: true
  selector:
    job-name: "@@JOB_NAME@@"
  ports:
    - name: rendezvous
      port: 29500
---
apiVersion: batch/v1
kind: Job
metadata:
  name: "@@JOB_NAME@@"
  labels:
    cosmos-job: "@@JOB_NAME@@"
spec:
  completionMode: Indexed
  completions: @@NUM_NODES@@
  parallelism: @@NUM_NODES@@
  backoffLimit: 0
  ttlSecondsAfterFinished: @@TTL_SECONDS@@
  template:
    metadata:
      labels:
        cosmos-job: "@@JOB_NAME@@"
    spec:
      restartPolicy: Never
      subdomain: "@@JOB_NAME@@"          # pods get FQDN <job>-<index>.<svc>.<ns>.svc.cluster.local
      imagePullSecrets:
        - name: "@@IMAGE_PULL_SECRET@@"
      containers:
        - name: cosmos
          image: "@@IMAGE@@"
          command: ["/bin/sh", "-c", "export NODE_RANK=${JOB_COMPLETION_INDEX:-0}; echo \"[cosmos-k8s] node $NODE_RANK/$NNODES master=$MASTER_ADDR:$MASTER_PORT\"; @@COMMAND@@"]
          resources:
            limits:
              "nvidia.com/gpu": "@@GPUS_PER_NODE@@"
          envFrom:
            - secretRef:
                name: "@@CRED_SECRET@@"
          env:
            # The command must invoke torchrun with these topology arguments.
            - name: NNODES
              value: "@@NUM_NODES@@"
            - name: NPROC_PER_NODE
              value: "@@GPUS_PER_NODE@@"
            - name: MASTER_PORT
              value: "29500"
            - name: MASTER_ADDR
              value: "@@JOB_NAME@@-0.@@JOB_NAME@@"
            - name: COSMOS_RESULTS_ROOT
              value: "@@RESULTS_DIR@@"
          volumeMounts:
            - name: dshm
              mountPath: /dev/shm
            - name: data
              mountPath: "@@MOUNT_PATH@@"
      volumes:
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "@@SHM_SIZE@@"
        - name: data
          persistentVolumeClaim:
            claimName: "@@PVC_CLAIM@@"
