@@ -0,0 +1,70 @@
+"""A scoring split repair must reuse training and preserve earlier evidence."""
+
+import hashlib
+import json
+import runpy
+from pathlib import Path
+
+import pytest
+
+
+@pytest.mark.parametrize("remaining", [2200, 750, 300])
+@pytest.mark.parametrize("score_only", [False, True])
+def test_completed_training_is_rescored_without_update(tmp_path, monkeypatch, score_only, remaining):
+    data = tmp_path / "evaluation.jsonl"
+    data.write_text("{}\n")
+    root = tmp_path / "results"
+    root.mkdir()
+    for name in ("RESULTS", "SOURCE", "ASSETS", "SCORE_DATA"):
+        monkeypatch.setenv(name, str(data if name == "SCORE_DATA" else root))
+    monkeypatch.setenv("FACTORIAL_CANARY", "0")
+    monkeypatch.setenv("FACTORIAL_SCORE_ONLY", str(int(score_only)))
+    monkeypatch.setenv("WORK_SECONDS", "2200")
+    for base in ("bf16", "nf4"):
+        folder = root / "frozen" / base
+        folder.mkdir(parents=True)
+        (folder / "complete.json").write_text('{"old": true}\n')
+    folder = root / "seed17/bf16_adamw"
+    checkpoint = folder / "training/checkpoints/iter_000016"
+    checkpoint.mkdir(parents=True)
+    (folder / "training/metrics.jsonl").write_text('{"optim/optimizer_step":16,"optim/nonfinite_skips_total":0}\n')
+    (folder / "training.end.txt").write_text("123\n")
+    (folder / "complete.json").write_text('{"old": true}\n')
+    (folder / "score").mkdir()
+    (folder / "score/scores.jsonl").write_text("preserve development evidence\n")
+    calls = []
+
+    def invoke(command, **kwargs):
+        # Stop at the next new training cell after testing the three rescoring calls.
+        if "tools.native_qlora_qualification.score" not in command:
+            raise StopIteration
+        calls.append(command)
+        Path(command[command.index("--output") + 1]).mkdir()
+
+    monkeypatch.setattr("subprocess.run", invoke)
+    driver = Path(__file__).with_name("run_factorial.py")
+    ticks = iter([0])
+    monkeypatch.setattr("time.monotonic", lambda: next(ticks, 2200 - remaining))
+    if remaining == 300:
+        with pytest.raises(SystemExit) as stop:
+            runpy.run_path(str(driver), run_name="__main__")
+        assert stop.value.code == 0
+        assert not calls
+        return
+    if score_only:
+        runpy.run_path(str(driver), run_name="__main__")
+        marker = json.loads((root / "pending-seedNone-scoreTrue.json").read_text())
+        assert marker["scope_complete"] and not marker["complete"]
+    elif remaining == 750:
+        runpy.run_path(str(driver), run_name="__main__")
+        marker = json.loads((root / "pending.json").read_text())
+        assert marker["seed"] == 17 and marker["optimizer"] == "adamw_bnb_8bit"
+    else:
+        with pytest.raises(StopIteration):
+            runpy.run_path(str(driver), run_name="__main__")
+    assert len(calls) == 3
+    assert calls[-1][calls[-1].index("--checkpoint") + 1] == str(checkpoint)
+    assert (folder / "complete.json").read_text() == '{"old": true}\n'
+    assert (folder / "score/scores.jsonl").read_text() == "preserve development evidence\n"
+    marker = json.loads((folder / "final_score.complete.json").read_text())
+    assert marker["data_sha256"] == hashlib.sha256(data.read_bytes()).hexdigest()
