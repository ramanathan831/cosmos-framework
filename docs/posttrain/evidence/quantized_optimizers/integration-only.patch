diff --git a/cosmos_framework/posttrain/tests/test_adapter_consolidated_quantized.py b/cosmos_framework/posttrain/tests/test_adapter_consolidated_quantized.py
new file mode 100644
index 0000000..1f3eb67
--- /dev/null
+++ b/cosmos_framework/posttrain/tests/test_adapter_consolidated_quantized.py
@@ -0,0 +1,108 @@
+"""Disposable integration: native adapter transactions with real quantized CUDA state."""
+
+import subprocess
+import sys
+
+import pytest
+import torch
+from torch import nn
+
+from cosmos_framework.posttrain.algorithm.primitives.objective import Objective, Reduction
+from cosmos_framework.posttrain.config.build import build_lr_scheduler, build_optimizer
+from cosmos_framework.posttrain.config.rl import OptimizerConfig
+from cosmos_framework.posttrain.model.checkpoint import build_adapter_checkpoint_codec
+from cosmos_framework.posttrain.roles.trainer.llm import LLMTrainer
+from cosmos_framework.posttrain.utils.rank_state import collect_rank_state
+
+
+class FrozenBase(nn.Linear):
+    def state_dict(self, *args, **kwargs):
+        raise AssertionError("packed/frozen base must not be extracted")
+
+
+class Net(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.base = FrozenBase(1024, 1024, bias=False, device="cuda", dtype=torch.bfloat16).requires_grad_(False)
+        self.lora_A = nn.Linear(1024, 128, bias=False, device="cuda")
+        self.lora_B = nn.Linear(128, 1024, bias=False, device="cuda")
+        nn.init.zeros_(self.lora_B.weight)
+        self._cosmos_adapter_parameters = {"lora_A.weight": self.lora_A.weight, "lora_B.weight": self.lora_B.weight}
+        self._cosmos_adapter_checkpoint_codec = build_adapter_checkpoint_codec(
+            self, identity={"base": "fixed-bf16-fixture", "revision": "a" * 40}
+        )
+
+    def forward(self, x):
+        return self.base(x.bfloat16()).float() + self.lora_B(self.lora_A(x))
+
+
+def objective(model, batch):
+    loss = model(torch.randn(2, 1024, device="cuda")).square().mean()
+    return loss, {"loss": float(loss.detach())}
+
+
+def trainer(name):
+    torch.manual_seed(17)
+    model = Net()
+    cfg = OptimizerConfig(name=name, lr=1e-3, warmup_steps=2)
+    opt = build_optimizer(model, cfg)
+    return LLMTrainer(
+        model,
+        Objective(objective, reduction=Reduction.MEAN),
+        opt,
+        checkpoint_format="consolidated",
+        lr_scheduler=build_lr_scheduler(opt, cfg),
+    )
+
+
+@pytest.mark.parametrize("name", ["adamw_bnb_8bit", "paged_adamw_8bit"])
+def test_fresh_process_adapter_transaction(name, tmp_path):
+    if not torch.cuda.is_available():
+        pytest.skip("real CUDA required")
+    source = trainer(name)
+    base = source.model.base.weight.detach().clone()
+    for _ in range(3):
+        source.train([None])
+    checkpoint = tmp_path / "iter_000003"
+    source.save(str(checkpoint), data_state=collect_rank_state({"cursor": 3}))
+    assert bool(source.opt.state_report()["paged_moment_bytes"]) == (name == "paged_adamw_8bit")
+    assert torch.equal(base, source.model.base.weight)
+    # Portable model-only exports can reload without an optimizer/backend import.
+    artifact_hint = tmp_path / "checkpoints" / "iter_000003"
+    with pytest.warns(UserWarning, match="partial checkpoint artifact"):
+        source.save(str(artifact_hint), components=["model"])
+    artifact = tmp_path / "checkpoint_artifacts" / "iter_000003"
+    portable_code = """
+import sys, torch
+from cosmos_framework.posttrain.tests.test_adapter_consolidated_quantized import Net
+from cosmos_framework.posttrain.checkpoint.adapter import load_adapter_weights
+from cosmos_framework.posttrain.checkpoint.manager import CheckpointManager
+sys.modules['bitsandbytes'] = None
+torch.manual_seed(17); n=Net()
+load_adapter_weights(sys.argv[1],n._cosmos_adapter_checkpoint_codec,manager=CheckpointManager())
+assert 'bitsandbytes.optim' not in sys.modules
+"""
+    subprocess.run([sys.executable, "-c", portable_code, str(artifact)], check=True)
+    output = tmp_path / "continued.pt"
+    code = """
+import sys, torch
+from cosmos_framework.posttrain.tests.test_adapter_consolidated_quantized import trainer
+from cosmos_framework.posttrain.utils.rank_state import state_for_current_rank
+t = trainer(sys.argv[1]); assert t.load(sys.argv[2]) == 3
+assert state_for_current_rank(t.checkpoint_manager.load_component(sys.argv[2], 'data'))['cursor'] == 3
+assert bool(t.opt.state_report()['paged_moment_bytes']) == (sys.argv[1] == 'paged_adamw_8bit')
+for _ in range(4): t.train([None])
+torch.save({'weights':t._adapter_checkpoint_codec().view.state_dict(), 'optimizer':t.opt.state_dict(), 'scheduler':t.lr_scheduler.state_dict()},sys.argv[3])
+"""
+    subprocess.run([sys.executable, "-c", code, name, str(checkpoint), str(output)], check=True)
+    for _ in range(4):
+        source.train([None])
+    restored = torch.load(output, weights_only=False)
+    for key, value in source._adapter_checkpoint_codec().view.state_dict().items():
+        assert torch.equal(value, restored["weights"][key])
+    assert source.lr_scheduler.state_dict() == restored["scheduler"]
+    for key, state in source.opt.state_dict()["state"].items():
+        for field, value in state.items():
+            actual = restored["optimizer"]["state"][key][field]
+            assert torch.equal(value, actual) if isinstance(value, torch.Tensor) else value == actual
+    assert torch.equal(base, source.model.base.weight)
