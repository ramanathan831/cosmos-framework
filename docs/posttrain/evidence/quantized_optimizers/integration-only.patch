+#!/usr/bin/env bash
+#SBATCH --job-name=optimizer-factorial
+#SBATCH --partition=polar,polar3,polar4,grizzly
+#SBATCH --account=edgeai_tao-ptm_image-foundation-model-clip
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gpus-per-node=1
+#SBATCH --cpus-per-task=8
+#SBATCH --mem=128G
+#SBATCH --time=40
+#SBATCH --no-requeue
+set -euo pipefail
+: "${SOURCE:?}" "${SOURCE_ARCHIVE:?}" "${ASSETS:?}" "${RESULTS:?}" "${CONTAINER_IMAGE:?}" "${WHEEL:?}"
+mkdir -p "$RESULTS"
+scontrol show job "$SLURM_JOB_ID" > "$RESULTS/job-$SLURM_JOB_ID.txt"
+srun --kill-on-bad-exit=1 --container-image="$CONTAINER_IMAGE" \
+  --container-mounts=/lustre:/lustre --container-workdir="$SOURCE" --container-writable \
+  --container-env=SOURCE,SOURCE_ARCHIVE,ASSETS,RESULTS,SFT_DATA_ROOT,SCORE_DATA,WHEEL,FACTORIAL_CANARY,FACTORIAL_SEED_ONLY,FACTORIAL_SCORE_ONLY,EXPECTED_GPU_NAME,WORK_SECONDS,COSMOS_TRAINING_CODE_REVISION,COSMOS_TRAINING_WHEEL_SHA256 \
+  bash -c '
+    set -euo pipefail
+    export PATH="$ASSETS/environment/bin:$PATH"
+    SOURCE=$(mktemp -d /tmp/cosmos-optimizer-factorial.XXXXXX); export SOURCE
+    tar -xzf "$SOURCE_ARCHIVE" -C "$SOURCE"
+    OVERLAY=$(mktemp -d /tmp/cosmos-optimizer-wheel.XXXXXX)
+    python -m zipfile -e "$WHEEL" "$OVERLAY"
+    export PYTHONPATH="$OVERLAY:$SOURCE" PYTHONDONTWRITEBYTECODE=1
+    export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=disabled OMP_NUM_THREADS=8
+    export CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONHASHSEED=42
+    export SFT_MODEL_PATH="$ASSETS/models/Qwen3-VL-8B-Instruct/0c351dd01ed87e9c1b53cbc748cba10e6187ff3b"
+    if [[ -n "${EXPECTED_GPU_NAME:-}" ]]; then
+      python -c "import os, torch; assert torch.cuda.get_device_name() == os.environ[\"EXPECTED_GPU_NAME\"], torch.cuda.get_device_name()"
+    fi
+    if [[ "${FACTORIAL_CANARY:-0}" == 1 && ! -f "$RESULTS/runtime_tests.passed" ]]; then
+      python -m pytest "$SOURCE/cosmos_framework/posttrain/tests/test_adapter_consolidated_quantized.py" "$SOURCE/cosmos_framework/posttrain/tests/test_checkpoint_adapter.py" "$SOURCE/cosmos_framework/posttrain/tests/test_entrypoints_sft_qlora.py" "$SOURCE/cosmos_framework/posttrain/tests/test_model_qwen3_vl_qlora.py" --confcutdir="$SOURCE/cosmos_framework/posttrain/tests" --override-ini="addopts=" > "$RESULTS/runtime_tests.log" 2>&1
+      echo passed > "$RESULTS/runtime_tests.passed"
+    fi
+    exec python "$SOURCE/tools/quantized_optimizers/run_factorial.py"
+  '
diff --git a/tools/quantized_optimizers/factorial_recovery.py b/tools/quantized_optimizers/factorial_recovery.py
