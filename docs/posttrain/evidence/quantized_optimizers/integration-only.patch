index 0000000..e46b710
--- /dev/null
+++ b/tools/quantized_optimizers/test_analyze_factorial.py
@@ -0,0 +1,54 @@
+"""Guard statistical pairing and the unchanged release margins."""
+
+from tools.quantized_optimizers.analyze_factorial import SEEDS, analyze, paired_bootstrap
+
+
+def test_recovery_rejects_dtype_and_clock_changes():
+    import pytest
+    import torch
+
+    from tools.quantized_optimizers.factorial_recovery import equal_tree
+
+    state = {"step": 8, "state1": torch.zeros(3, dtype=torch.uint8)}
+    equal_tree(state, {"step": 8, "state1": state["state1"].clone()})
+    with pytest.raises(AssertionError, match="dtype|tensor"):
+        equal_tree(state, {"step": 8, "state1": state["state1"].float()})
+    with pytest.raises(AssertionError, match="scalar"):
+        equal_tree(state, {"step": 9, "state1": state["state1"]})
+
+
+def test_missing_cells_never_pass():
+    result = analyze({}, [])
+    assert result["complete"] is False
+    assert len(result["missing"]) == 14
+    assert "comparisons" not in result
+
+
+def test_parity_is_not_an_adaptation_gain():
+    rows = [
+        {"id": str(i), "native_sft_ce": i + 1, "native_supervised_tokens": 2, "restricted_choice_correct": bool(i % 2)}
+        for i in range(4)
+    ]
+    pairs = {seed: rows for seed in SEEDS}
+    groups = {str(i): str(i // 2) for i in range(4)}
+    for crossed in (False, True):
+        result = paired_bootstrap(pairs, pairs, rows, groups, crossed=crossed)
+        assert result["bounds"]["nll_ratio"]["ci95"] == [1, 1]
+        assert result["bounds"]["accuracy_degradation"]["ci95"] == [0, 0]
+        assert result["gates"] == {"nll": True, "accuracy": True, "positive_adaptation": False}
+        assert not result["all_gates_pass"]
+
+
+def test_large_consistent_quality_regression_fails_both_group_procedures():
+    reference = [
+        {"id": str(i), "native_sft_ce": 1, "native_supervised_tokens": 2, "restricted_choice_correct": True}
+        for i in range(4)
+    ]
+    candidate = [dict(row, native_sft_ce=1.02, restricted_choice_correct=False) for row in reference]
+    groups = {str(i): str(i // 2) for i in range(4)}
+    for crossed in (False, True):
+        result = paired_bootstrap(
+            {seed: candidate for seed in SEEDS}, {seed: reference for seed in SEEDS}, reference, groups, crossed=crossed
+        )
+        assert not any(result["gates"].values())
+        assert not result["all_gates_pass"]
