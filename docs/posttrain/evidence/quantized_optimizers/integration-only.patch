new file mode 100644
index 0000000..9caa4a6
--- /dev/null
+++ b/tools/quantized_optimizers/run_factorial.py
@@ -0,0 +1,240 @@
+"""Bounded disposable integration comparison; completed arms are never rerun."""
+
+import hashlib
+import json
+import os
+import subprocess
+import time
+from pathlib import Path
+
+root = Path(os.environ["RESULTS"])
+root.mkdir(parents=True, exist_ok=True)
+started = time.monotonic()
+source = Path(os.environ["SOURCE"])
+config = "cosmos_framework/posttrain/configs/sft_optimizer_factorial.py"
+base_order = [("bf16", "adamw"), ("bf16", "adamw_bnb_8bit"), ("nf4", "adamw"), ("nf4", "adamw_bnb_8bit")]
+canary = os.environ.get("FACTORIAL_CANARY", "0") == "1"
+seed_only = int(os.environ["FACTORIAL_SEED_ONLY"]) if os.environ.get("FACTORIAL_SEED_ONLY") else None
+score_only = os.environ.get("FACTORIAL_SCORE_ONLY", "0") == "1"
+if seed_only is not None and seed_only not in (17, 29, 43):
+    raise ValueError("FACTORIAL_SEED_ONLY must select a prespecified paired seed")
+if canary and (seed_only is not None or score_only):
+    raise ValueError("canary must run its complete four-cell scope")
+progress = root / (
+    "pending.json" if seed_only is None and not score_only else f"pending-seed{seed_only}-score{score_only}.json"
+)
+(root / f"execution-{os.environ.get('SLURM_JOB_ID', 'local')}.json").write_text(
+    json.dumps(
+        {
+            "seed_only": seed_only,
+            "score_only": score_only,
+            "node": os.environ.get("SLURM_JOB_NODELIST"),
+            "cpu_affinity": sorted(os.sched_getaffinity(0)),
+            "source_archive": os.environ.get("SOURCE_ARCHIVE"),
+        }
+    )
+    + "\n"
+)
+score_data = Path(os.environ.get("SCORE_DATA", str(Path(os.environ["ASSETS"]) / "data/canary/validation.jsonl")))
+score_name = "score" if canary else "final_score"
+if not canary and "SCORE_DATA" not in os.environ:
+    raise ValueError("full comparisons require an explicit recording-disjoint SCORE_DATA")
+score_sha = hashlib.sha256(score_data.read_bytes()).hexdigest()
+
+
+def enough_time(required_seconds=900):
+    return time.monotonic() - started <= int(os.environ.get("WORK_SECONDS", "2200")) - required_seconds
+
+
+def score(folder, env, *, arm, checkpoint=None):
+    marker_path = folder / (score_name + ".complete.json")
+    if marker_path.exists():
+        if json.loads(marker_path.read_text())["data_sha256"] != score_sha:
+            raise ValueError("existing score used different data")
+        return
+    if not enough_time(420):
+        progress.write_text(json.dumps({"score": str(folder)}) + "\n")
+        raise SystemExit(0)
+    if (folder / score_name).exists():
+        raise RuntimeError(f"prior incomplete score requires inspection: {folder / score_name}")
+    command = [
+        "torchrun",
+        "--standalone",
+        "--nproc-per-node=1",
+        "-m",
+        "tools.native_qlora_qualification.score",
+        "--config",
+        config,
+        "--data",
+        str(score_data),
+        "--output",
+        str(folder / score_name),
+        "--max-rows",
+        "2" if canary else "16",
+        "--seed",
+        "2026",
+        "--arm",
+        arm,
+    ]
+    if checkpoint is not None:
+        command += ["--checkpoint", str(checkpoint)]
+    score_start = time.time()
+    (folder / (score_name + ".start.txt")).write_text(str(score_start) + "\n")
+    with (folder / (score_name + ".log")).open("w") as log:
+        subprocess.run(command, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)
+    marker_path.write_text(
+        json.dumps(
+            {
+                "data_sha256": score_sha,
+                "start_unix": score_start,
+                "end_unix": time.time(),
+                "source": env.get("COSMOS_TRAINING_CODE_REVISION"),
+                "checkpoint": str(checkpoint),
+            }
+        )
+        + "\n"
+    )
+
+
+# Deterministic zero-B adapters leave each base unchanged. These references are
+# evaluated once, with the same media/score contract as every trained cell.
+if not canary:
+    for base in ("bf16", "nf4"):
+        folder = root / "frozen" / base
+        if (folder / (score_name + ".complete.json")).exists():
+            score(folder, os.environ, arm="frozen_" + base)
+            continue
+        if not enough_time(420):
+            progress.write_text(json.dumps({"frozen": base}) + "\n")
+            raise SystemExit(0)
+        if folder.exists() and not (folder / "complete.json").exists():
+            raise RuntimeError(f"prior incomplete frozen reference requires inspection: {folder}")
+        folder.mkdir(parents=True, exist_ok=True)
+        env = dict(
+            os.environ,
+            FACTORIAL_SEED="17",
+            FACTORIAL_BASE=base,
+            FACTORIAL_OPTIMIZER="adamw",
+            FACTORIAL_STEPS="16",
+            FACTORIAL_VAL_ROWS="16",
+        )
+        if not (folder / "start.txt").exists():
+            (folder / "start.txt").write_text(str(time.time()) + "\n")
+        score(folder, env, arm="frozen_" + base)
+        if not (folder / "complete.json").exists():
+            (folder / "complete.json").write_text(
+                json.dumps({"base": base, "frozen": True, "end_unix": time.time()}) + "\n"
+            )
+
+# Prioritize the already-prespecified native recovery gate once both seed17
+# checkpoints exist. It must not be crowded out by later quality trials.
+if not canary and all(
+    (root / "seed17" / (base + "_adamw_bnb_8bit") / "complete.json").exists() for base in ("bf16", "nf4")
+):
+    from tools.quantized_optimizers.factorial_recovery import recover
+
+    if not recover(root, source, config, started=started, work_seconds=int(os.environ.get("WORK_SECONDS", "2200"))):
+        raise SystemExit(0)
+
+plan = (
+    [(17, b, o) for b, o in base_order]
+    if canary
+    else [(seed, b, o) for i, seed in enumerate((17, 29, 43)) for b, o in base_order[i:] + base_order[:i]]
+)
+for seed, base, optimizer in plan:
+    if seed_only is not None and seed != seed_only:
+        continue
+    folder = root / f"seed{seed}" / (base + "_" + optimizer)
+    if score_only and not (folder / "complete.json").exists():
+        continue  # Only completed training owns a stable checkpoint for rescoring.
+    if (folder / "complete.json").exists() and (folder / (score_name + ".complete.json")).exists():
+        score(folder, os.environ, arm=base + "_" + optimizer)
+        continue
+    if not enough_time(420 if (folder / "training.end.txt").exists() else 900):
+        progress.write_text(json.dumps({"seed": seed, "base": base, "optimizer": optimizer}) + "\n")
+        break
+    if folder.exists() and not (folder / "training.end.txt").exists():
+        raise RuntimeError(f"prior incomplete arm requires inspection: {folder}")
+    folder.mkdir(parents=True, exist_ok=True)
+    env = dict(
+        os.environ,
+        FACTORIAL_SEED=str(seed),
+        FACTORIAL_BASE=base,
+        FACTORIAL_OPTIMIZER=optimizer,
+        FACTORIAL_STEPS="2" if canary else "16",
+        FACTORIAL_VAL_ROWS="2" if canary else "16",
+        RESULTS=str(folder),
+        PROBE_ARM="native",
+        IMAGINAIRE_OUTPUT_ROOT=str(folder / "training"),
+        COSMOS_QLORA_METRICS_FILE=str(folder / "native_phases.jsonl"),
+    )
+    if not (folder / "training.end.txt").exists():
+        (folder / "start.txt").write_text(str(time.time()) + "\n")
+        with (folder / "train.log").open("w") as log:
+            subprocess.run(
+                [
+                    "torchrun",
+                    "--standalone",
+                    "--nproc-per-node=1",
+                    str(source / "tools/quantized_optimizers/native_probe.py"),
+                    "--config",
+                    config,
+                    "--",
+                    "rl.save_every=" + ("2" if canary else "8"),
+                    "rl.keep_optim_last=0",
+                ],
+                env=env,
+                stdout=log,
+                stderr=subprocess.STDOUT,
+                check=True,
+            )
+        (folder / "training.end.txt").write_text(str(time.time()) + "\n")
+    checkpoints = list((folder / "training").rglob("checkpoints/iter_" + ("000002" if canary else "000016")))
+    if len(checkpoints) != 1:
+        raise RuntimeError(f"ambiguous/missing native checkpoint: {checkpoints}")
+    metrics = list((folder / "training").rglob("metrics.jsonl"))
+    rows = [json.loads(line) for line in metrics[0].read_text().splitlines()]
+    if rows[-1]["optim/optimizer_step"] != int(env["FACTORIAL_STEPS"]) or rows[-1]["optim/nonfinite_skips_total"]:
+        raise RuntimeError("incomplete or skipped factorial updates")
+    score(folder, env, arm=base + "_" + optimizer, checkpoint=checkpoints[0])
+    if not (folder / "complete.json").exists():
+        (folder / "complete.json").write_text(
+            json.dumps(
+                {
+                    "seed": seed,
+                    "base": base,
+                    "optimizer": optimizer,
+                    "checkpoint": str(checkpoints[0]),
+                    "end_unix": time.time(),
+                    "canary": canary,
+                }
+            )
+            + "\n"
+        )
+else:
+    if canary:
+        progress.write_text('{"complete": true}\n')
+    else:
+        from tools.quantized_optimizers.factorial_recovery import recover
+
+        ready = all(
+            (root / "seed17" / (base + "_adamw_bnb_8bit") / "complete.json").exists() for base in ("bf16", "nf4")
+        )
+        recovered = ready and recover(
+            root, source, config, started=started, work_seconds=int(os.environ.get("WORK_SECONDS", "2200"))
+        )
+        all_cells = all(
+            (root / f"seed{seed}" / (base + "_" + opt) / "final_score.complete.json").exists()
+            for seed, base, opt in plan
+        )
+        progress.write_text(
+            json.dumps(
+                {
+                    "scope_complete": True,
+                    "seed_only": seed_only,
+                    "score_only": score_only,
+                    "complete": all_cells and recovered,
+                }
+            )
+            + "\n"
+        )
diff --git a/tools/quantized_optimizers/test_analyze_factorial.py b/tools/quantized_optimizers/test_analyze_factorial.py
