+"""Fresh native processes continue the saved mid-run BF16/NF4 adapter checkpoints."""
+
+import json
+import os
+import subprocess
+import time
+
+
+def equal_tree(left, right, path="state"):
+    import numpy as np
+    import torch
+
+    if isinstance(left, torch.Tensor):
+        if not isinstance(right, torch.Tensor) or left.dtype != right.dtype or not torch.equal(left, right):
+            raise AssertionError(f"tensor continuation mismatch at {path}")
+    elif isinstance(left, np.ndarray):
+        if not isinstance(right, np.ndarray) or left.dtype != right.dtype or not np.array_equal(left, right):
+            raise AssertionError(f"array continuation mismatch at {path}")
+    elif isinstance(left, dict):
+        if not isinstance(right, dict) or left.keys() != right.keys():
+            raise AssertionError(f"mapping continuation mismatch at {path}")
+        for key in left:
+            equal_tree(left[key], right[key], f"{path}.{key}")
+    elif isinstance(left, (list, tuple)):
+        if type(left) is not type(right) or len(left) != len(right):
+            raise AssertionError(f"sequence continuation mismatch at {path}")
+        for i, (a, b) in enumerate(zip(left, right, strict=True)):
+            equal_tree(a, b, f"{path}.{i}")
+    elif type(left) is not type(right) or left != right:
+        raise AssertionError(f"scalar continuation mismatch at {path}")
+
+
+def recover(root, source, config, *, started, work_seconds):
+    import torch
+
+    for base in ("bf16", "nf4"):
+        folder = root / "recovery" / base
+        if (folder / "complete.json").exists():
+            continue
+        if folder.exists():
+            raise RuntimeError(f"prior incomplete recovery requires inspection: {folder}")
+        original = root / "seed17" / (base + "_adamw_bnb_8bit")
+        marker = json.loads((original / "complete.json").read_text())
+        from pathlib import Path
+
+        expected = Path(marker["checkpoint"])
+        checkpoint = expected.parent / "iter_000008"
+        reference_folder = root / "recovery_reference" / base
+        needs_reference = not (checkpoint / "optim.pt").is_file()
+        reserve = 1500 if needs_reference and not (reference_folder / "complete.json").exists() else 900
+        if time.monotonic() - started > work_seconds - reserve:
+            (root / "pending.json").write_text(json.dumps({"recovery": base}) + "\n")
+            return False
+        if needs_reference:
+            # Consolidated retention deleted the old update8 optimizer component.
+            # Reproduce the original16 updates in a NEW correctness-only run with
+            # retention disabled; never reconstruct moments from model weights.
+            # Its final model/moments/data must match the original before using8.
+            if not (reference_folder / "complete.json").exists():
+                if reference_folder.exists():
+                    raise RuntimeError(f"incomplete recovery reference requires inspection: {reference_folder}")
+                reference_folder.mkdir(parents=True)
+                env = dict(
+                    os.environ,
+                    FACTORIAL_SEED="17",
+                    FACTORIAL_BASE=base,
+                    FACTORIAL_OPTIMIZER="adamw_bnb_8bit",
+                    FACTORIAL_STEPS="16",
+                    FACTORIAL_VAL_ROWS="16",
+                    RESULTS=str(reference_folder),
+                    PROBE_ARM="native",
+                    IMAGINAIRE_OUTPUT_ROOT=str(reference_folder / "training"),
+                    COSMOS_QLORA_METRICS_FILE=str(reference_folder / "native_phases.jsonl"),
+                )
+                (reference_folder / "start.txt").write_text(str(time.time()) + "\n")
+                with (reference_folder / "train.log").open("w") as log:
+                    subprocess.run(
+                        [
+                            "torchrun",
+                            "--standalone",
+                            "--nproc-per-node=1",
+                            str(source / "tools/quantized_optimizers/native_probe.py"),
+                            "--config",
+                            config,
+                            "--",
+                            "rl.save_every=8",
+                            "rl.keep_optim_last=0",
+                        ],
+                        env=env,
+                        stdout=log,
+                        stderr=subprocess.STDOUT,
+                        check=True,
+                    )
+                references = list((reference_folder / "training").rglob("checkpoints/iter_000016"))
+                if len(references) != 1:
+                    raise RuntimeError("recovery reference checkpoint missing or ambiguous")
+                replay = references[0]
+                for component in ("model", "optim", "data"):
+                    equal_tree(
+                        torch.load(expected / (component + ".pt"), map_location="cpu", weights_only=False),
+                        torch.load(replay / (component + ".pt"), map_location="cpu", weights_only=False),
+                        "reference." + component,
+                    )
+                (reference_folder / "complete.json").write_text(
+                    json.dumps(
+                        {
+                            "checkpoint": str(replay),
+                            "original": str(expected),
+                            "exact": True,
+                            "purpose": "correctness-only deterministic replay after optimizer retention removed8; excluded from quality/timing comparisons",
+                        }
+                    )
+                    + "\n"
+                )
+            replay = Path(json.loads((reference_folder / "complete.json").read_text())["checkpoint"])
+            checkpoint = replay.parent / "iter_000008"
+            if not (checkpoint / "optim.pt").is_file():
+                raise RuntimeError("recovery reference did not retain update8 optimizer")
+        folder.mkdir(parents=True)
+        env = dict(
+            os.environ,
+            FACTORIAL_SEED="17",
+            FACTORIAL_BASE=base,
+            FACTORIAL_OPTIMIZER="adamw_bnb_8bit",
+            FACTORIAL_STEPS="16",
+            FACTORIAL_VAL_ROWS="16",
+            RESULTS=str(folder),
+            PROBE_ARM="native",
+            IMAGINAIRE_OUTPUT_ROOT=str(folder / "training"),
+            COSMOS_QLORA_METRICS_FILE=str(folder / "native_phases.jsonl"),
+        )
+        (folder / "start.txt").write_text(str(time.time()) + "\n")
+        with (folder / "train.log").open("w") as log:
+            subprocess.run(
+                [
+                    "torchrun",
+                    "--standalone",
+                    "--nproc-per-node=1",
+                    str(source / "tools/quantized_optimizers/native_probe.py"),
+                    "--config",
+                    config,
+                    "--",
+                    "rl.save_every=8",
+                    "rl.keep_optim_last=0",
+                    "rl.resume=" + str(checkpoint),
+                ],
+                env=env,
+                stdout=log,
+                stderr=subprocess.STDOUT,
+                check=True,
+            )
+        paths = list((folder / "training").rglob("checkpoints/iter_000016"))
+        if len(paths) != 1:
+            raise RuntimeError("resumed final checkpoint missing or ambiguous")
+        restored = paths[0]
+        for component in ("model", "optim", "data"):
+            a = torch.load(expected / (component + ".pt"), map_location="cpu", weights_only=False)
+            b = torch.load(restored / (component + ".pt"), map_location="cpu", weights_only=False)
+            equal_tree(a, b, component)
+        a = torch.load(expected / "trainer.pt", map_location="cpu", weights_only=False)
+        b = torch.load(restored / "trainer.pt", map_location="cpu", weights_only=False)
+        keys = (
+            "iter",
+            "optimizer_step",
+            "accum",
+            "n_mini",
+            "attempt_id",
+            "nonfinite_skips_total",
+            "nonfinite_skips_consecutive",
+            "rng",
+            "lr_scheduler",
+            "lr_scheduler_clock",
+            "objective_identity",
+            "adapter_training",
+        )
+        for key in keys:
+            equal_tree(a[key], b[key], "trainer." + key)
+        metric_paths = list((folder / "training").rglob("metrics.jsonl"))
+        original_paths = list((original / "training").rglob("metrics.jsonl"))
+        rows = [json.loads(line) for line in metric_paths[0].read_text().splitlines()]
+        reference = {r["step"]: r for r in (json.loads(line) for line in original_paths[0].read_text().splitlines())}
+        updates = [r for r in rows if "train/loss_avg" in r]
+        if [r["step"] for r in updates] != list(range(9, 17)):
+            raise AssertionError("resume replayed or omitted updates")
+        for row in updates:
+            for key in ("train/loss_avg", "train/grad_norm", "train/learning_rate", "train/valid_token_count"):
+                equal_tree(reference[row["step"]][key], row[key], f"metrics.{row['step']}.{key}")
+        (folder / "complete.json").write_text(
+            json.dumps(
+                {
+                    "base": base,
