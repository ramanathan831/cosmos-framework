index 0000000..5a52893
--- /dev/null
+++ b/tools/quantized_optimizers/test_factorial_recovery.py
@@ -0,0 +1,90 @@
+"""Retained recovery references never replace quality trials or invent moments."""
+
+import json
+from pathlib import Path
+
+import pytest
+import torch
+
+from tools.quantized_optimizers.factorial_recovery import recover
+
+
+@pytest.mark.parametrize("retained", [False, True])
+def test_recovery_replays_only_pruned_reference_and_keeps_original(tmp_path, monkeypatch, retained):
+    keys = (
+        "iter",
+        "optimizer_step",
+        "accum",
+        "n_mini",
+        "attempt_id",
+        "nonfinite_skips_total",
+        "nonfinite_skips_consecutive",
+        "rng",
+        "lr_scheduler",
+        "lr_scheduler_clock",
+        "objective_identity",
+        "adapter_training",
+    )
+    trainer = {key: {"value": torch.tensor([16])} for key in keys}
+    components = {
+        "model": {"weight": torch.tensor([1.0])},
+        "optim": {"state": torch.tensor([3], dtype=torch.uint8)},
+        "data": {"cursor": 64},
+        "trainer": trainer,
+    }
+
+    def checkpoint(path, *, optimizer=True):
+        path.mkdir(parents=True)
+        for name, value in components.items():
+            if name != "optim" or optimizer:
+                torch.save(value, path / (name + ".pt"))
+
+    def metrics(folder, start):
+        folder.mkdir(parents=True, exist_ok=True)
+        (folder / "metrics.jsonl").write_text(
+            "\n".join(
+                json.dumps(
+                    {
+                        "step": step,
+                        "train/loss_avg": 1.0 / step,
+                        "train/grad_norm": 0.5,
+                        "train/learning_rate": 0.01,
+                        "train/valid_token_count": 100,
+                    }
+                )
+                for step in range(start, 17)
+            )
+        )
+
+    originals = []
+    for base in ("bf16", "nf4"):
+        original = tmp_path / "seed17" / (base + "_adamw_bnb_8bit")
+        final = original / "training/checkpoints/iter_000016"
+        checkpoint(final)
+        checkpoint(final.parent / "iter_000008", optimizer=retained)
+        metrics(original / "training", 1)
+        (original / "complete.json").write_text(json.dumps({"checkpoint": str(final)}))
+        originals.append(final.parent / "iter_000008/optim.pt")
+    calls = []
+
+    def invoke(command, *, env, **kwargs):
+        assert "rl.keep_optim_last=0" in command
+        calls.append(command)
+        folder = Path(env["IMAGINAIRE_OUTPUT_ROOT"])
+        checkpoint(folder / "checkpoints/iter_000016")
+        is_resume = any(value.startswith("rl.resume=") for value in command)
+        if not is_resume:
+            checkpoint(folder / "checkpoints/iter_000008")
+        metrics(folder, 9 if is_resume else 1)
+
+    monkeypatch.setattr("subprocess.run", invoke)
+    monkeypatch.setattr("time.monotonic", lambda: 0)
+    assert recover(tmp_path, tmp_path, "config", started=0, work_seconds=3000)
+    assert len(calls) == (2 if retained else 4)
+    assert all(p.exists() == retained for p in originals)
+    for base in ("bf16", "nf4"):
+        result = json.loads((tmp_path / "recovery" / base / "complete.json").read_text())
+        assert result["exact"] and result["from_update"] == 8 and result["through_update"] == 16
+    # An already completed correctness check must not train again.
+    assert recover(tmp_path, tmp_path, "config", started=0, work_seconds=3000)
+    assert len(calls) == (2 if retained else 4)
