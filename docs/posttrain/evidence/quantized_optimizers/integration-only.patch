+"""Disposable BF16/NF4 x FP32/eight-bit optimizer comparison, not a mainline recipe."""
+
+import os
+
+from cosmos_framework.posttrain.configs.sft_qwen3_vl_8b_lora import build_config
+
+
+def make_config():
+    config = build_config(quantized=os.environ.get("FACTORIAL_BASE", "bf16") == "nf4")
+    seed = int(os.environ.get("FACTORIAL_SEED", "17"))
+    steps = int(os.environ.get("FACTORIAL_STEPS", "16"))
+    name = os.environ.get("FACTORIAL_OPTIMIZER", "adamw")
+    config.job.name = os.environ.get("FACTORIAL_BASE", "bf16") + "_" + name
+    config.rl.seed = seed
+    config.model.model_config.adapter.initialization_seed = seed
+    config.rl.max_steps = steps
+    config.rl.optimizer.warmup_steps = 2 if steps > 2 else 0
+    config.rl.lr_schedule.cycle_steps = steps
+    config.rl.optimizer.name = name
+    config.rl.optimizer.impl = "fused" if name == "adamw" else ""
+    config.rl.micro_batch_size = 4
+    config.rl.grad_accum = 1
+    config.rl.checkpoint_format = "consolidated"
+    config.rl.save_every = steps
+    config.rl.validation.max_samples = int(os.environ.get("FACTORIAL_VAL_ROWS", "16"))
+    config.rl.validation.batch_size = 4
+    config.rl.validation.every_steps = 8 if steps > 2 else steps
+    config.rl.processor_kwargs["videos_kwargs"]["size"] = {"shortest_edge": 262144, "longest_edge": 1048576}
+    return config
