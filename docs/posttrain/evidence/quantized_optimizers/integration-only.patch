diff --git a/tools/quantized_optimizers/analyze_factorial.py b/tools/quantized_optimizers/analyze_factorial.py
new file mode 100644
index 0000000..9bb032b
--- /dev/null
+++ b/tools/quantized_optimizers/analyze_factorial.py
@@ -0,0 +1,431 @@
+"""Preregistered paired optimizer/base-precision analysis on reused WTS groups.
+
+Every incomplete cell remains visible; no missing cell is substituted. The
+bootstrap retains recording families and identical-video connected components.
+This script analyzes teacher-forced task scores, not free-form generation.
+"""
+
+import argparse
+import gzip
+import json
+import math
+import random
+from collections import defaultdict
+from pathlib import Path
+
+from tools.native_qlora_qualification.common import inventory_groups
+from tools.native_qlora_qualification.quality import INPUT_KEYS, metrics, validate_scores
+from tools.quantized_optimizers.analyze_development import interval, parse_time
+
+SEEDS = (17, 29, 43)
+CELLS = ("bf16_adamw", "bf16_adamw_bnb_8bit", "nf4_adamw", "nf4_adamw_bnb_8bit")
+
+
+def paired_bootstrap(candidate, reference, frozen, groups, *, crossed, repetitions=10000):
+    """Seed/group paired draws, preserving whole groups and token weighting."""
+    anchor = candidate[17]
+    by_group = defaultdict(list)
+    for i, row in enumerate(anchor):
+        by_group[groups[row["id"]]].append(i)
+    if len(by_group) < 2:
+        return {"estimable": False, "reason": "fewer than two connected recording groups"}
+    totals = {}
+    for seed in SEEDS:
+        totals[seed] = []
+        for group in sorted(by_group):
+            indices = by_group[group]
+            totals[seed].append(
+                (
+                    len(indices),
+                    sum(
+                        candidate[seed][i]["native_sft_ce"] * candidate[seed][i]["native_supervised_tokens"]
+                        for i in indices
+                    ),
+                    sum(
+                        reference[seed][i]["native_sft_ce"] * reference[seed][i]["native_supervised_tokens"]
+                        for i in indices
+                    ),
+                    sum(candidate[seed][i]["restricted_choice_correct"] for i in indices),
+                    sum(reference[seed][i]["restricted_choice_correct"] for i in indices),
+                    sum(frozen[i]["restricted_choice_correct"] for i in indices),
+                )
+            )
+    rng = random.Random(2026)
+    values = defaultdict(list)
+    count = len(by_group)
+    for _ in range(repetitions):
+        seeds = rng.choices(SEEDS, k=3)
+        shared = rng.choices(range(count), k=count) if crossed else None
+        sampled = []
+        for seed in seeds:
+            draws = shared if crossed else rng.choices(range(count), k=count)
+            sampled.extend(totals[seed][g] for g in draws)
+        n, loss_a, loss_b, correct_a, correct_b, correct_f = map(math.fsum, zip(*sampled, strict=True))
+        if loss_b <= 0:
+            raise ValueError("nonpositive reference NLL")
+        values["nll_ratio"].append(loss_a / loss_b)
+        values["accuracy_degradation"].append((correct_b - correct_a) / n)
+        values["adaptation_gain"].append((correct_a - correct_f) / n)
+    bounds = {}
+    for key, samples in values.items():
+        samples.sort()
+        bounds[key] = {
+            "ci95": [samples[math.ceil(repetitions * p) - 1] for p in (0.025, 0.975)],
+            "lower_one_sided95": samples[math.ceil(repetitions * 0.05) - 1],
+            "upper_one_sided95": samples[math.ceil(repetitions * 0.95) - 1],
+        }
+    gates = {
+        "nll": bounds["nll_ratio"]["upper_one_sided95"] <= 1.01,
+        "accuracy": bounds["accuracy_degradation"]["upper_one_sided95"] <= 0.01,
+        "positive_adaptation": bounds["adaptation_gain"]["lower_one_sided95"] > 0,
+    }
+    return {
+        "estimable": True,
+        "groups": count,
+        "repetitions": repetitions,
+        "rng_seed": 2026,
+        "crossed_group_draws": crossed,
+        "bounds": bounds,
+        "gates": gates,
+        "all_gates_pass": repetitions == 10000 and all(gates.values()),
+    }
+
+
+def analyze(raw, inventory):
+    cells, scores, frozen, missing = {}, {}, {}, []
+    for base in ("bf16", "nf4"):
+        key = f"frozen/{base}/final_score/scores.jsonl"
+        if key in raw and f"frozen/{base}/final_score.complete.json" in raw:
+            frozen[base] = [json.loads(line) for line in raw[key].splitlines()]
+        else:
+            missing.append("frozen/" + base)
+    for seed in SEEDS:
+        for cell in CELLS:
+            prefix = f"seed{seed}/{cell}/"
+            if prefix + "complete.json" not in raw or prefix + "final_score.complete.json" not in raw:
+                missing.append(prefix)
+                continue
+            marker = json.loads(raw[prefix + "complete.json"])
+            if marker["canary"]:
+                raise ValueError("canaries cannot be promoted to full comparisons")
+            score_rows = [json.loads(line) for line in raw[prefix + "final_score/scores.jsonl"].splitlines()]
+            summary = json.loads(raw[prefix + "final_score/summary.json"])
+            if not summary["complete"]:
+                raise ValueError("incomplete task scoring")
+            metric_files = [k for k in raw if k.startswith(prefix + "training/") and k.endswith("/metrics.jsonl")]
+            if len(metric_files) != 1:
+                raise ValueError("missing or ambiguous native metrics")
+            rows = [json.loads(line) for line in raw[metric_files[0]].splitlines()]
+            if rows[-1].get("optim/optimizer_step") != 16 or rows[-1].get("optim/nonfinite_skips_total"):
+                raise ValueError("incomplete or skipped training")
+            clock, curve = 0, []
+            for row in rows:
+                clock += row.get("timer/e2e_step_s", 0) + row.get("timer/validation_s", 0)
+                if "val/loss_avg" in row:
+                    curve.append(
+                        {
+                            "step": row["step"],
+                            "seconds": clock,
+                            "nll": row["val/loss_avg"],
+                            "wall_seconds": parse_time(row["time"]) - float(raw[prefix + "start.txt"]),
+                        }
+                    )
+            cells[seed, cell] = {
+                "seed": seed,
+                "cell": cell,
+                "curve": curve,
+                "task_metrics": metrics(score_rows),
+                "training_seconds": sum(r.get("timer/e2e_step_s", 0) for r in rows),
+                "supervised_tokens": [r["train/valid_token_count"] for r in rows if "train/valid_token_count" in r],
+                "wall_training_and_scoring_seconds": float(raw[prefix + "training.end.txt"])
+                - float(raw[prefix + "start.txt"])
+                + json.loads(raw[prefix + "final_score.complete.json"])["end_unix"]
+                - json.loads(raw[prefix + "final_score.complete.json"])["start_unix"],
+            }
+            scores[seed, cell] = score_rows
+            telemetry = [json.loads(line) for line in raw.get(prefix + "native.telemetry.jsonl", "").splitlines()]
+            updates = [row for row in telemetry if row["kind"] == "optimizer"]
+            # Include all real allocations, but exclude startup kernel probes.
+            updates = [
+                row
+                for row in updates
+                if row.get("trainable_elements", row.get("state", {}).get("trainable_elements", 0)) > 1e6
+            ]
+            run = cells[seed, cell]
+            run["torch_peak_bytes"] = max((r["peak_allocated"] for r in updates), default=None)
+            run["process_gpu_peak_bytes"] = max(
+                (r["process_gpu_bytes"] for r in updates if r.get("process_gpu_bytes") is not None), default=None
+            )
+            run["host_rss_peak_kib"] = max((r["host_rss_kib"] for r in updates), default=None)
+            run["optimizer_seconds"] = [r["optimizer_seconds"] for r in updates]
+            run["state"] = (
+                updates[-1].get("state", {"state_bytes": updates[-1].get("state_bytes")}) if updates else None
+            )
+            run["wall_training_seconds"] = (
+                float(raw[prefix + "training.end.txt"]) - float(raw[prefix + "start.txt"])
+                if prefix + "training.end.txt" in raw
+                else None
+            )
+            phases = [json.loads(line) for line in raw.get(prefix + "native_phases.jsonl", "").splitlines()]
+            phases = [
+                row
+                for row in phases
+                if float(raw[prefix + "start.txt"]) <= row["unix_seconds"] <= float(raw[prefix + "training.end.txt"])
+            ]
+            run["torch_peak_bytes"] = max(
+                [run["torch_peak_bytes"] or 0] + [row["cuda"]["peak_allocated_bytes"] for row in phases]
+            )
+            run["host_high_water_bytes"] = max((row["host_peak_rss_bytes"] for row in phases), default=None)
+            run["task_score_seconds"] = summary["elapsed_seconds"]
+            run["forward_shapes"] = [r for r in telemetry if r["kind"] == "forward"]
+    output = {
+        "complete": not missing,
+        "missing": missing,
+        "runs": list(cells.values()),
+        "data_history": "User-approved reuse of earlier QLoRA train/eval groups; no untouched claim",
+        "quality_kind": "teacher-forced restricted-choice original WTS task and multi-question token NLL",
+        "release": "NOT QUALIFIED: all preregistered correctness, quality and speed gates required",
+    }
+    output["recovery"] = {
+        base: json.loads(raw[f"recovery/{base}/complete.json"])
+        for base in ("bf16", "nf4")
+        if f"recovery/{base}/complete.json" in raw
+    }
+    output["recovery_complete"] = len(output["recovery"]) == 2 and all(r["exact"] for r in output["recovery"].values())
+    if missing:
+        return output
+    frozen_adapter_hashes = {
+        base: json.loads(raw[f"frozen/{base}/final_score/summary.json"])["adapter_tensors_sha256"]
+        for base in ("bf16", "nf4")
+    }
+    if len(set(frozen_adapter_hashes.values())) != 1:
+        raise ValueError("BF16/NF4 initial adapter tensors differ")
+    output["frozen_initial_adapter_hashes"] = frozen_adapter_hashes
+    anchor = scores[17, CELLS[0]]
+    for rows in [*scores.values(), *frozen.values()]:
+        validate_scores(rows)
+        if len(rows) != len(anchor) or any(
+            any(a[k] != b[k] for k in INPUT_KEYS) for a, b in zip(anchor, rows, strict=True)
+        ):
+            raise ValueError("task score media, input, mask, row order or token counts differ")
+    groups = inventory_groups(inventory)
+    if any(row["id"] not in groups for row in anchor):
+        raise ValueError("full media inventory omits scored rows")
+    manifest = json.loads(raw["final_selection.json"])
+    selected = {row["id"]: row for row in manifest["rows"]}
+    if set(selected) != {row["id"] for row in anchor}:
+        raise ValueError("scored rows do not match the prespecified final selection")
+    excluded = set(manifest["excluded"]["train"] + manifest["excluded"]["validation"])
+    inventory_sha = {row["id"]: row["sha256"] for row in inventory}
+    for row in anchor:
+        if groups[row["id"]] in excluded or groups[row["id"]] != selected[row["id"]]["group"]:
+            raise ValueError("final scored recording overlaps training/development or has wrong group")
+        if row["media_sha256"] != selected[row["id"]]["sha256"] or row["media_sha256"] != inventory_sha[row["id"]]:
+            raise ValueError("scored media bytes differ from the full inventory")
+    for key, value in raw.items():
+        if key.endswith("final_score.complete.json") and json.loads(value)["data_sha256"] != manifest["output_sha256"]:
+            raise ValueError("a final score used different data")
+    output["recording_separation_pass"] = True
+    budget = min(run["curve"][-1]["seconds"] for run in cells.values())
+    wall_budget = min(run["curve"][-1]["wall_seconds"] for run in cells.values())
+    output["equal_wall_budget_seconds"] = wall_budget
+    output["equal_budget_seconds"] = budget
+    output["groups"] = {row["id"]: groups[row["id"]] for row in anchor}
+    for seed in SEEDS:
+        target = cells[seed, "bf16_adamw"]["curve"][0]["nll"] * 0.95
+        for cell in CELLS:
+            run = cells[seed, cell]
+            if run["supervised_tokens"] != cells[seed, "bf16_adamw"]["supervised_tokens"]:
+                raise ValueError("training data exposure differs")
+
+            def training_shapes(item):
+                return [
+                    {key: row.get(key) for key in ("shapes", "sequence_lengths", "video_grid_thw", "image_grid_thw")}
+                    for row in item["forward_shapes"]
+                    if row["grad_enabled"]
+                ]
+
+            if training_shapes(run) != training_shapes(cells[seed, "bf16_adamw"]):
+                raise ValueError("paired training media/sequence shape order differs")
+            reference = cells[seed, cell.split("_")[0] + "_adamw"]
+            if run["curve"][0]["nll"] != reference["curve"][0]["nll"]:
+                raise ValueError("optimizer arms differ before their first update")
+            run["matched_training_controls_pass"] = True
+            run["target_nll"] = target
+            run["target_seconds"] = next((p["seconds"] for p in run["curve"] if p["nll"] <= target), None)
+            run["equal_budget_point"] = [p for p in run["curve"] if p["seconds"] <= budget][-1]
+            run["wall_target_seconds"] = next((p["wall_seconds"] for p in run["curve"] if p["nll"] <= target), None)
+            eligible = [p for p in run["curve"] if p["wall_seconds"] <= wall_budget]
+            run["equal_wall_budget_point"] = eligible[-1] if eligible else None
+    output["comparisons"] = {}
+    comparisons = [(base + "_adamw_bnb_8bit", base + "_adamw", base) for base in ("bf16", "nf4")]
+    comparisons += [("nf4_" + opt, "bf16_" + opt, "nf4") for opt in ("adamw", "adamw_bnb_8bit")]
+    for candidate, reference, base in comparisons:
+        a = {seed: scores[seed, candidate] for seed in SEEDS}
+        b = {seed: scores[seed, reference] for seed in SEEDS}
+        pairs = [(cells[seed, candidate], cells[seed, reference]) for seed in SEEDS]
+        stats = {
+            "final_validation_nll_ratio": interval([x["curve"][-1]["nll"] / y["curve"][-1]["nll"] for x, y in pairs]),
+            "training_speed_ratio": interval([y["training_seconds"] / x["training_seconds"] for x, y in pairs]),
+            "time_to_quality_speed_ratio": interval(
+                [
+                    y["target_seconds"] / x["target_seconds"]
+                    for x, y in pairs
+                    if x["target_seconds"] and y["target_seconds"]
+                ]
+            ),
+            "equal_budget_nll_gain": interval(
+                [y["equal_budget_point"]["nll"] - x["equal_budget_point"]["nll"] for x, y in pairs]
+            ),
+            "wall_time_to_quality_speed_ratio": interval(
+                [
+                    y["wall_target_seconds"] / x["wall_target_seconds"]
+                    for x, y in pairs
+                    if x["wall_target_seconds"] and y["wall_target_seconds"]
+                ]
+            ),
+            "equal_wall_budget_nll_gain": interval(
+                [
+                    y["equal_wall_budget_point"]["nll"] - x["equal_wall_budget_point"]["nll"]
+                    for x, y in pairs
+                    if x["equal_wall_budget_point"] and y["equal_wall_budget_point"]
+                ]
+            ),
+            "wall_training_speed_ratio": interval(
+                [y["wall_training_seconds"] / x["wall_training_seconds"] for x, y in pairs]
+            ),
+            "state_saving": interval(
+                [
+                    1
+                    - (
+                        x["state"].get(
+                            "state_bytes", x["state"].get("moment_bytes", 0) + x["state"].get("metadata_bytes", 0)
+                        )
+                    )
+                    / (
+                        y["state"].get(
+                            "state_bytes", y["state"].get("moment_bytes", 0) + y["state"].get("metadata_bytes", 0)
+                        )
+                    )
+                    for x, y in pairs
+                ]
+            ),
+            "hierarchical": paired_bootstrap(a, b, frozen[base], groups, crossed=False),
+            "crossed": paired_bootstrap(a, b, frozen[base], groups, crossed=True),
+        }
+        stats["task_token_nll_ratio"] = interval(
+            [metrics(a[s])["token_weighted_ce"] / metrics(b[s])["token_weighted_ce"] for s in SEEDS]
+        )
+        stats["task_accuracy_degradation"] = interval(
+            [metrics(b[s])["restricted_accuracy"] - metrics(a[s])["restricted_accuracy"] for s in SEEDS]
+        )
+        stats["task_accuracy_gain_over_frozen"] = interval(
+            [metrics(a[s])["restricted_accuracy"] - metrics(frozen[base])["restricted_accuracy"] for s in SEEDS]
+        )
+        stats["gates"] = {
+            "paired_validation_nll": stats["final_validation_nll_ratio"]["ci95"][1] <= 1.01,
+            "paired_task_nll": stats["task_token_nll_ratio"]["ci95"][1] <= 1.01,
+            "paired_task_accuracy": stats["task_accuracy_degradation"]["ci95"][1] <= 0.01,
+            "recording_group_quality_and_adaptation": all(
+                stats[k]["all_gates_pass"] for k in ("hierarchical", "crossed")
+            ),
+            "training_speed": stats["training_speed_ratio"]["ci95"][0] > 1.05,
+            "time_to_quality_speed": stats["time_to_quality_speed_ratio"]["n"] == 3
+            and stats["time_to_quality_speed_ratio"]["ci95"][0] > 1.05,
+            "equal_budget_nll_gain": stats["equal_budget_nll_gain"]["ci95"][0] > 0,
+            "wall_training_speed": stats["wall_training_speed_ratio"]["ci95"][0] > 1.05,
+            "wall_time_to_quality_speed": stats["wall_time_to_quality_speed_ratio"]["n"] == 3
+            and stats["wall_time_to_quality_speed_ratio"]["ci95"][0] > 1.05,
+            "equal_wall_budget_nll_gain": stats["equal_wall_budget_nll_gain"]["n"] == 3
+            and stats["equal_wall_budget_nll_gain"]["ci95"][0] > 0,
+            "state_saving": stats["state_saving"]["ci95"][0] >= 0.6
+            if candidate.endswith("bnb_8bit") and reference.endswith("adamw")
+            else None,
+        }
+        output["comparisons"][candidate + "_versus_" + reference] = stats
+    return output
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("raw", type=Path)
+    parser.add_argument("inventory", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    raw = (
+        json.loads(gzip.decompress(args.raw.read_bytes()))
+        if args.raw.suffix == ".gz"
+        else json.loads(args.raw.read_text())
+    )
+    inventory = [json.loads(line) for line in args.inventory.read_text().splitlines()]
+    result = analyze(raw, inventory)
+    args.output.write_text(json.dumps(result, indent=2, allow_nan=False) + "\n")
+    plot(result, args.output.with_suffix(".png"))
+
+
+def plot(result, output):
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    import numpy as np
+    from scipy.stats import t
+
+    fig, axes = plt.subplots(1, 4, figsize=(21, 4.8))
+    for cell in CELLS:
+        runs = [r for r in result["runs"] if r["cell"] == cell]
+        if not runs:
+            continue
+        label = cell.replace("_adamw_bnb_8bit", " + bnb8").replace("_adamw", " + fused FP32") + f" (n={len(runs)})"
+        times = np.mean([[p["seconds"] for p in r["curve"]] for r in runs], axis=0)
+        losses = np.array([[p["nll"] for p in r["curve"]] for r in runs])
+        axes[0].plot(times, losses.mean(axis=0), label=label)
+        if len(runs) > 1:
+            ci = t.ppf(0.975, len(runs) - 1) * losses.std(axis=0, ddof=1) / len(runs) ** 0.5
+            axes[0].fill_between(times, losses.mean(axis=0) - ci, losses.mean(axis=0) + ci, alpha=0.15)
+        wall_times = np.mean([[p["wall_seconds"] for p in r["curve"]] for r in runs], axis=0)
+        axes[1].plot(wall_times, losses.mean(axis=0), label=label)
+        if len(runs) > 1:
+            axes[1].fill_between(wall_times, losses.mean(axis=0) - ci, losses.mean(axis=0) + ci, alpha=0.15)
+        for ax, field in zip(axes[2:], ("torch_peak_bytes", "process_gpu_peak_bytes"), strict=True):
+            measured = [r for r in runs if r[field] is not None]
+            if not measured:
+                continue
+            x = interval([r[field] / 2**30 for r in measured])
+            y = interval([64 / r["training_seconds"] for r in measured])
+            ax.errorbar(
+                x["mean"],
+                y["mean"],
+                xerr=x["ci95"][1] - x["mean"] if x["ci95"] else None,
+                yerr=y["ci95"][1] - y["mean"] if y["ci95"] else None,
+                fmt="o",
+                capsize=4,
+                label=label,
+            )
+    axes[0].set(
+        xlabel="Training + validation seconds",
+        ylabel="Reused-group token NLL",
+        title="Factorial integration; 95% seed intervals",
+    )
+    axes[1].set(
+        xlabel="Launch-to-validation seconds",
+        ylabel="Development token NLL",
+        title="Includes initialization/checkpoint costs",
+    )
+    axes[2].set(
+        xlabel="Peak PyTorch allocated GiB",
+        ylabel="Training sequences/s",
+        title="FP32 adapters; frozen base excluded from state",
+    )
+    axes[3].set(
+        xlabel="Sampled process GPU peak GiB", ylabel="Training sequences/s", title="Sampled peak is a lower bound"
+    )
+    for ax in axes:
+        if ax.lines:
+            ax.legend(fontsize=7)
+    fig.tight_layout()
+    fig.savefig(output, dpi=180)
+
+
+if __name__ == "__main__":
+    main()
